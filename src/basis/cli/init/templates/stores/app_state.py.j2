"""
The app's example store (generated) — demonstrates the stores convention.

A module-scope instance (`app_state`) registers the store's blueprint so
`Page.stores` can resolve it by name (or default to all stores), SSR serializes
it into `#basis-initial-state`, and the client hydrates it from the same.
"""
from basis.shared.actions import server_action
from basis.shared.app_state import AppStateStore
from basis.plugins.theme import ThemeStore

#: The demo list's starting contents.
DEMO_ITEMS = ("hello", "basis")


class AppState(AppStateStore):
    """App-global item list — a projection of the app's authoritative state.

    ``AppStateStore`` is the base for state the SERVER owns: the data lives on
    the app (here ``app.state.items``) and the store is a JSON-safe projection of
    it. SSR serializes the projection into ``#basis-initial-state`` and every
    server action answers with a fresh projection, so all clients converge on
    the same list.

    A plain ``Store`` holds *client* state instead: a server action runs on a
    fresh per-request instance there, so mutating ``self`` inside one never
    accumulates — the mutation is thrown away with the instance.
    """

    def project(self, app) -> dict:
        """Read the authoritative list (seeded with the demo items until written)."""
        items = getattr(app.state, "items", None)
        return {"items": list(DEMO_ITEMS if items is None else items)}

    def __init__(self, name: str = "app_state"):
        super().__init__(name)
        # Client-side default — only when nothing was hydrated, else the list
        # would disagree with the SSR tree this instance is hydrating against.
        if not getattr(self, "_hydrated_from_ssr", False):
            self.items = list(DEMO_ITEMS)

    @server_action
    def add_item(self) -> str:
        """Append the next demo item (canonical-path server action / full-stack RPC)."""
        app = self._require_app()
        items = self.project(app)["items"]
        items.append(f"item {len(items) + 1}")
        app.state.items = items
        return f"added {items[-1]}"


class AppTheme(ThemeStore):
    """The app's theme store — seeds the `basis init` answer (dark/light).

    The default is applied in ``__init__`` (guarded against SSR hydration) so
    the seed survives the per-request store rebuild: SSR reconstructs stores
    from their class blueprints, so a plain module-scope assignment would be
    lost. Toggle at runtime via ``theme.set_mode(...)``.
    """

    def __init__(self, name="theme"):
        super().__init__(name)
        if not getattr(self, "_hydrated_from_ssr", False):
            self.dark_mode = {{ "True" if theme_seed == "dark" else "False" }}


# Module-scope instances — the stores auto-discovery convention. Registering
# the theme store here guarantees `$theme` is available to <ui-theme-provider>.
app_state = AppState("app_state")
theme = AppTheme("theme")
