[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "A Basis web application"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "basis-framework",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ slug }}"]
