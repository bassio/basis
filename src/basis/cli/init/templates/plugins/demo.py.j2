"""
A demo plugin (generated) — contributes a view into the ``workspace-center``
region, proving the regions + revertible-plugin story. Delete this file (or
answer "no" to the example-plugin question) to drop it.
"""
from pathlib import Path

from basis.server.plugin import BasisPlugin
from basis.shared.component import Component


class DemoView(Component):
    """A view contributed into the workspace-center region."""

    __tag__ = "{{ slug }}-demo-view"

    def style(self):
        """
        /* Scoped to this component: the region's chrome belongs to whoever
           contributes the view, not to the frame that hosts the region. */
        .demo-view {
            margin-top: 1.25rem;
            padding: 1.15rem 1.25rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-soft);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
        }
        .demo-view h3 {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0 0 0.4rem;
            font-size: 0.95rem;
        }
        .demo-view h3::before {
            content: "";
            width: 0.4rem;
            height: 0.4rem;
            border-radius: 50%;
            background: var(--accent-color);
        }
        .demo-view p {
            margin: 0;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }
        .demo-view code {
            font-family: var(--font-mono);
            font-size: 0.9em;
            background: var(--bg-tertiary);
            padding: 0.15em 0.4em;
            border-radius: var(--radius-sm);
        }
        """

    def template(self):
        """
        <div class="demo-view">
            <h3>Plugin view</h3>
            <p>Contributed by <code>plugins/demo.py</code> into the
               <code>workspace-center</code> region.</p>
        </div>
        """


plugin = BasisPlugin(
    prefix="",
    serving_dir=Path(__file__).parent,
    serving_mount="/{{ slug }}/plugins",
    name="demo",
)

# Declare the contribution; `include_plugin` flushes it into the app registry
# (and records it on the PluginRegistration for revertible disable/remove).
plugin.add_to_region("workspace-center", DemoView)
